+/** Encodes linear light (in rgb8 * 2^exponent units) as RGBExp32 with the smallest exponent that fits. */
+fn encode_rgb_exp32(rgb: [f64; 3]) -> [u8; 4] {
+    let max = rgb.iter().copied().fold(0.0_f64, f64::max);
+    if max <= 0.0 {
+        return [0, 0, 0, 0];
+    }
+    let exponent = ((max / 255.0).log2().ceil() as i32).clamp(-128, 127);
+    let scale = 2.0_f64.powi(-exponent);
+    let channel = |value: f64| (value * scale).round().clamp(0.0, 255.0) as u8;
+    [channel(rgb[0]), channel(rgb[1]), channel(rgb[2]), exponent as i8 as u8]
+}
